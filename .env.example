# GardenGrow AI — environment variables
# Copy this file to .env and fill in your values. Never commit .env.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Required: your OpenAI API key (platform.openai.com → API keys). Starts with sk-
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: the model Live AI uses for photo analysis and chat.
# Options: gpt-6.1-terra (recommended), gpt-6-luna (cheapest), gpt-6.1-sol, gpt-6-astra (best)
OPENAI_MODEL=gpt-6.1-terra

# Optional: a class code students enter once to use Live AI. Leave blank for no code.
CLASS_CODE=

# Optional: AI requests allowed per person per day (default 200).
DAILY_LIMIT=200

# Optional: other websites allowed to call the AI server, comma-separated.
# The app's own Vercel site is always allowed, so you can usually leave this blank.
ALLOWED_ORIGINS=
